#!/usr/bin/env python3
"""Remove mock build environments for a functional test project."""

import os
import sys

from rift.Config import Config
from rift.Mock import Mock


def main():
    project_dir = sys.argv[1] if len(sys.argv) > 1 else os.getcwd()
    os.chdir(project_dir)

    config = Config()
    config.load()

    for arch in config.get('arch', ['x86_64']):
        mock = Mock(config, arch)
        mock.scrub()


if __name__ == '__main__':
    main()
